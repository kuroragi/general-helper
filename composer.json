{
  "name": "kuroragi/general-helper",
  "version": "2.0.0",
  "description": "General helpers, blameable trait, activity log service, and macros for Laravel.",
  "type": "library",
  "keywords": [
    "laravel",
    "helper",
    "blameable",
    "activity-log",
    "erp",
    "macro",
    "blueprint",
    "eloquent"
  ],
  "homepage": "https://github.com/kuroragi/general-helper",
  "license": "MIT",
  "authors": [
    {
      "name": "Kuroragi",
      "email": "kuroragidigitalstudio@gmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/kuroragi/general-helper/issues",
    "source": "https://github.com/kuroragi/general-helper"
  },
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "spatie/laravel-permission": "^5.5|^6.0|^7.0",
    "barryvdh/laravel-dompdf": "^2.0|^3.0|^4.0",
    "livewire/livewire": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "Kuroragi\\GeneralHelper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kuroragi\\GeneralHelper\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Kuroragi\\GeneralHelper\\Providers\\GeneralHelperServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/phpunit",
    "post-autoload-dump": [
      "@php artisan package:discover --ansi || true"
    ]
  }
}